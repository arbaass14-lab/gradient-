# Node.js 24 LTS required. Copy this file to .env in this folder.
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# Create a Google OAuth Web application client. Never share its secret.
# Redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated verified Google emails. Applied ONLY when a user is created.
ADMIN_EMAILS=

# Optional access restrictions. Leave both blank to allow any verified Google account.
# If you want to restrict access, set either allowed emails or verified Google Workspace domains.
# Domain checks use Google's verified "hd" claim, not the email suffix.
ALLOWED_EMAILS=
ALLOWED_GOOGLE_DOMAINS=

# Persistent private directory, relative to project root or an absolute path.
# Never expose this directory through Nginx/Apache or put it inside dist/public.
DATA_DIR=./data
SESSION_HOURS=8
STREAM_TTL_SECONDS=300

# Use 1 only behind exactly one trusted reverse proxy, with direct access blocked.
TRUST_PROXY_HOPS=0
